<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job to run the calendar→Salesforce sync every Friday at 17:00.

  Install:
    1. Edit the PATHS below to match your machine.
    2. Save (without .example) at:
         ~/Library/LaunchAgents/com.taboola.calsync.plist
    3. Load it:
         launchctl unload ~/Library/LaunchAgents/com.taboola.calsync.plist 2>/dev/null || true
         launchctl load   ~/Library/LaunchAgents/com.taboola.calsync.plist
    4. Test fire it now:
         launchctl start com.taboola.calsync
    5. Inspect logs in ~/Documents/Non-activity-tracking/logs/
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.taboola.calsync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/REPLACE_ME/Documents/Non-activity-tracking/scripts/run_weekly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME/Documents/Non-activity-tracking</string>

    <!-- Fridays at 17:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>17</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_ME/Documents/Non-activity-tracking/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_ME/Documents/Non-activity-tracking/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
